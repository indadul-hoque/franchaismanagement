# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/franchisedb

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_SECRET_KEY=your_user_access_secret_here
JWT_REFRESH_TOKEN_SECRET_KEY=your_user_refresh_secret_here
JWT_SECRET_KEY=your_franchise_secret_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Gmail App Password) ───────────────────────────────────────────────
FROM_GMAIL=your_email@gmail.com
FROM_GMAIL_PASS=your_16_char_app_password

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_API_URL=https://your-whatsapp-api-url.com

